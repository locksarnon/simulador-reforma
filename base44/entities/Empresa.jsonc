      "type": "string"
    },
    "setor": {
      "type": "string"
    },
    "uf": {
      "type": "string"
    },
    "municipio": {
      "type": "string"
    },
    "contribuinte_ibs_cbs": {
      "type": "string"
    },
    "produtor_rural": {
      "type": "string"
    },
