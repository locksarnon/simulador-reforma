# Copie para .env e preencha com valores reais antes de rodar `docker compose up`.
# Nunca commite o .env de verdade.

POSTGRES_USER=reforma
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=reforma

MINIO_ROOT_USER=reforma
MINIO_ROOT_PASSWORD=troque-por-uma-senha-forte

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Radar de Novidades da Reforma Tributária — gera em https://aistudio.google.com/apikey
# Precisa de faturamento ativado no projeto Google para a busca na web funcionar.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Cadastro por convite: com um código definido, só quem o informar cria conta.
# Vazio = cadastro aberto (ok no notebook, NÃO em produção).
INVITE_CODE=

# E-mail (relatórios, avisos de lead, newsletter). Sem SMTP_HOST o envio fica desligado.
# Ex.: Resend -> SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=resend SMTP_PASS=<api key>
APP_PUBLIC_URL=https://simulador.clarityib.com.br
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=InTAX <contato@seudominio.com.br>
MAIL_REPLY_TO=
