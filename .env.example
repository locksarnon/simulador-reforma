# Copie para .env e preencha com valores reais antes de rodar `docker compose up`.
# Nunca commite o .env de verdade.

POSTGRES_USER=reforma
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=reforma

MINIO_ROOT_USER=reforma
MINIO_ROOT_PASSWORD=troque-por-uma-senha-forte

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Radar de Novidades da Reforma Tributária — gera em https://aistudio.google.com/apikey
# Precisa de faturamento ativado no projeto Google para a busca na web funcionar.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Cadastro por convite: com um código definido, só quem o informar cria conta.
# Vazio = cadastro aberto (ok no notebook, NÃO em produção).
INVITE_CODE=

# E-mail (relatórios, avisos de lead, newsletter). Sem SMTP_HOST o envio fica desligado.
# O endereço de MAIL_FROM precisa ser a própria caixa autenticada em SMTP_USER
# (ou ter permissão de envio em nome dela), senão o provedor recusa a mensagem.
# Ex.: Microsoft 365 -> SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_SECURE=false
APP_PUBLIC_URL=https://simulador.clarityib.com.br
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Microsoft 365 por token (OAuth2 client credentials): preenchendo as TRÊS
# variáveis abaixo, o envio passa a autenticar por token do aplicativo e
# SMTP_PASS deixa de ser usado — SMTP_USER continua sendo o endereço da caixa
# remetente. Vazias (ou só uma parte preenchida) = autenticação por senha.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

MAIL_FROM=InTAX <contato@seudominio.com.br>
MAIL_REPLY_TO=

# Cofre de certificados digitais A1 dos clientes (repositório de XML).
# Chave-mestra: 32 bytes aleatórios em base64. NUNCA vai para o Git e precisa de cópia de segurança FORA do banco:
# sem ela os certificados guardados não abrem e os clientes teriam de reenviá-los.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Para trocar a chave sem perder o que já foi guardado: CERT_VAULT_KEYS="v2:<nova em base64>,v1:<antiga em base64>" (a primeira cifra, todas abrem).
# O id da chave antiga TEM de ser v1: é o id que a CERT_VAULT_KEY única grava nos certificados. Com outro id, os certificados guardados deixam de abrir.
CERT_VAULT_KEY=

# Agendador da captura automática de XML (Distribuição de DF-e). Ligue SÓ no servidor de produção (CAPTURA_XML_AGENDADOR=on):
# dois consumidores do mesmo CNPJ (por exemplo um computador de desenvolvimento com cópia dos dados) fazem a SEFAZ bloquear o cliente.
# Fora de "on" a captura só roda pelo botão "Capturar agora" da empresa.
CAPTURA_XML_AGENDADOR=
