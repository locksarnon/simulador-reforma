  perspectiva   Perspectiva
  operacao_id   String?
  lote_id       String?
  importado_em  DateTime?
  createdAt     DateTime     @default(now())

  @@index([grupo_id])
  @@index([chave_nfe, numero_item, perspectiva])
}

// ─────────────────────────────────────────────────────────────────────────
// Simulacao — snapshot imutável de uma rodada de cálculo do simulador.
//
// O motor (taxEngine.js) roda hoje inteiramente ao vivo no navegador: nada
// do que ele calcula fica gravado em lugar nenhum, então não há como provar
// depois com que regras/premissas um número foi produzido. Este model é o
// registro de auditoria que faltava — "Salvar simulação" grava aqui uma
// cópia imutável da entrada e do resultado.
// ─────────────────────────────────────────────────────────────────────────

model Simulacao {
  id             String   @id @default(cuid())
  grupo_id       String?
  empresa_id     String?
  nome           String?
  escopo         String
  input_hash     String
  versao_motor   String
  versao_regras  String
  entrada_json   String
  resultado_json String
  criado_por     String?
  createdAt      DateTime @default(now())

  @@index([grupo_id])
  @@index([input_hash])
}

// ─────────────────────────────────────────────────────────────────────────
// Catálogos oficiais adicionais — NCM, CFOP e Benefício Fiscal eram apenas
// campos de texto livre em Operacao/ImportacaoXMLItem (qualquer valor
// passava, mesmo um código inexistente). Estes três models tornam-os
// catálogos de verdade, no mesmo padrão de ClassTrib/CstIbsCbs/CredPres —
// mas a validação continua "leniente": só bloqueia um código quando o
// catálogo já tem pelo menos uma linha cadastrada (evita quebrar quem ainda
// não populou a base).
// ─────────────────────────────────────────────────────────────────────────

model Ncm {
  id          String    @id @default(cuid())
  codigo      String
  descricao   String?
  status      String    @default("Ativo")
  observacao  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([codigo])
}

model Cfop {
  id               String    @id @default(cuid())
  codigo           String
  descricao        String?
  tipo_operacao    String?
  aplicavel_a      String?
  status           String    @default("Ativo")
  observacao       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([codigo])
}

model BeneficioFiscal {
  id                String    @id @default(cuid())
  codigo            String
  descricao         String?
  uf                String?
  fundamento_legal  String?
  vigencia_inicio   DateTime?
  vigencia_fim      DateTime?
  status            String    @default("Ativo")
  observacao        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([codigo])
}

// ─────────────────────────────────────────────────────────────────────────
// Ferramentas — submódulos utilitários (não presos a Grupo/Empresa)
// ─────────────────────────────────────────────────────────────────────────

/**
 * Correlação Item LC 116 <-> NBS <-> cIndOp <-> cClassTrib, importada do
 * Anexo VIII (Receita Federal / Comitê Gestor da NFS-e). Alimenta o
 * Classificador cClassTrib, o Conversor LC116<->NBS, o Identificador cIndOp
 * e o Conversor 4-em-1 — são recortes diferentes da mesma tabela oficial.
 */
model CorrelacaoServico {
  id                    String   @id @default(cuid())
  item_lc116            String?
  descricao_item        String?
  nbs                   String?
  descricao_nbs         String?
  ps_onerosa            String?
  adq_exterior          String?
  ind_op                String?
  local_incidencia_ibs  String?
  c_class_trib          String?
  nome_class_trib       String?
  fonte                 String   @default("Anexo VIII RTC")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([item_lc116])
  @@index([nbs])
  @@index([ind_op])
  @@index([c_class_trib])
}

/** Acervo de notícias sobre a Reforma Tributária — lista curada manualmente. */
model NoticiaReforma {
  id           String    @id @default(cuid())
  titulo       String
  resumo       String?
  url          String?
  fonte        String?
  publicado_em DateTime?
  tags         String?
  status       String    @default("Publicada")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([publicado_em])
}
