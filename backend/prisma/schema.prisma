generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  admin
  user
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         Role      @default(user)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Enums (portados de base44/entities/*.jsonc)
// ─────────────────────────────────────────────────────────────────────────

enum Direcao {
  Saida
  Entrada
}

enum TipoOperacao {
  Mercadoria
  Servico
  Outro
}

enum SituacaoOperacao {
  ATIVA
  CANCELADA
  ESTORNADA
}

enum StatusDiagnostico {
  rascunho
  em_progresso
  em_validacao
  finalizado
}

enum StatusLoteXML {
  RECEBIDO
  PROCESSANDO
  AGUARDANDO_CONFIRMACAO
  PROCESSADO
  PROCESSADO_COM_FALHAS
  FALHOU
}

enum TipoXml {
  NFE_PROC
  NFE
  EVENTO_CANCELAMENTO
  EVENTO_CARTA_CORRECAO
  EVENTO_OUTRO
  // Reconhecidos pela raiz do XML, mas sem extração de itens/tributos —
  // schemas totalmente diferentes da NF-e (CT-e tem ICMS sobre frete, MDF-e
  // é manifesto sem dado tributário, e NFS-e varia por prefeitura — mais de
  // 5000 layouts municipais distintos, sem padrão nacional viável de cobrir
  // aqui; só a "NFS-e nacional", padrão mais recente, é reconhecida).
  CTE
  MDFE
  NFSE
  XML_DESCONHECIDO
}

enum SituacaoFiscalXML {
  AUTORIZADO
  AUTORIZADO_FORA_PRAZO
  CANCELADO
  HOMOLOGACAO
  SEM_PROTOCOLO
  DUPLICADO_HASH
  DUPLICADO_CHAVE
  INVALIDO
  EVENTO_PROCESSADO
  EVENTO_PENDENTE
  IGNORADO
  ERRO_PROCESSAMENTO
}

enum StatusTecnico {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  FALHOU
}

enum Perspectiva {
  EMITENTE
  DESTINATARIO
  PENDENTE
}

enum TipoRelacionamento {
  TERCEIRO
  INTERCOMPANY
  TRANSFERENCIA_INTERNA
}

enum ResultadoFinalXML {
  IMPORTAVEL
  IMPORTAVEL_COM_ALERTA
  BLOQUEADO
  CANCELADO
  DUPLICADO
  CONFIRMADO
  ESTORNADO
}

// ─────────────────────────────────────────────────────────────────────────
// Entidades de dados (portadas de base44/entities/*.jsonc)
// ─────────────────────────────────────────────────────────────────────────

