{
  "name": "@simulador-reforma/api",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador FAL — Reforma Tributária — backend próprio (NestJS + PostgreSQL, substitui o backend hospedado Base44)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
