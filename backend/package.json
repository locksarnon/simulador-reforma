    "typescript": "^5.8.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.41.1": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
